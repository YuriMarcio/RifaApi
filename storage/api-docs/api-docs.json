        "/api/raffle/create": {
            "post": {
                "tags": [
                    "Raffle"
                ],
                "summary": "Cria uma rifa",
                "operationId": "b731a046813cac4dfc468fbbd4c71df4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "raffleType",
                                    "startDate",
                                    "endDate",
                                    "ticketPrice",
                                    "maxTicketsPerUser",
                                    "maxParticipants",
                                    "paymentMethod",
                                    "awards"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Rifa de Natal"
                                    },
                                    "raffleType": {
                                        "type": "string",
                                        "example": "sorteio"
                                    },
                                    "startDate": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2024-12-01T00:00:00Z"
                                    },
                                    "endDate": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2024-12-31T23:59:59Z"
                                    },
                                    "ticketPrice": {
                                        "type": "number",
                                        "example": 10
                                    },
                                    "maxTicketsPerUser": {
                                        "type": "integer",
                                        "example": 5
                                    },
                                    "maxParticipants": {
                                        "type": "integer",
                                        "example": 100
                                    },
                                    "paymentMethod": {
                                        "type": "string",
                                        "example": "Cartão de Crédito"
                                    },
                                    "awards": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "Id": {
                                                    "type": "string",
                                                    "example": "award1"
                                                },
                                                "Title": {
                                                    "type": "string",
                                                    "example": "Prêmio 1"
                                                },
                                                "Description": {
                                                    "type": "string",
                                                    "example": "Descrição do prêmio"
                                                },
                                                "tagType": {
                                                    "type": "string",
                                                    "example": "Product"
                                                },
                                                "images": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "file"
                                                    }
                                                },
                                                "Value": {
                                                    "type": "number",
                                                    "example": 100
                                                },
                                                "image": {
                                                    "type": "file"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Rifa criada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Rifa criada com sucesso"
                                        },
                                        "raffle": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Erro de validação",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Erro de validação"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno do servidor"
                    }
                }
            }
        },
